rules_version = '2';

// Sim Baking House — Firestore security rules
//
// Verified against the live project (2026-08-08) via unauthenticated REST
// calls: writes to every existing collection were already rejected (403),
// and only `products`/`categories` allowed public reads. This file
// formalizes that behavior explicitly and adds an admin-write path for
// the upcoming iOS admin screen — nothing here weakens what's live today.
//
// Deploy: paste into Firebase Console > Firestore Database > Rules,
// or `firebase deploy --only firestore:rules` if the CLI is set up.
service cloud.firestore {
  match /databases/{database}/documents {

    // True only for a UID explicitly allow-listed in /admins.
    // That collection is itself unwritable from any client (see below),
    // so this cannot be self-granted — it can only be set from the
    // Firebase Console or a trusted backend (e.g. Admin SDK).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Per-item shape check for a cart item (see carts/{uid} below). Rules
    // has no forEach/every for a variable-length list, so itemOk() is
    // checked at a fixed, bounded set of indices instead of iterating —
    // see MAX_CART_ITEMS by that match block for why 30 is enough and
    // where the index list that uses this is generated.
    function isValidCartItem(item) {
      return item is map
        && item.productId is string
        && item.name is string
        && item.qty is int
        && item.qty >= 1
        && item.qty <= 99;
    }
    function itemOk(items, i) {
      return i >= items.size() || isValidCartItem(items[i]);
    }
    function itemsValid(items) {
      return itemOk(items, 0) &&
        itemOk(items, 1) &&
        itemOk(items, 2) &&
        itemOk(items, 3) &&
        itemOk(items, 4) &&
        itemOk(items, 5) &&
        itemOk(items, 6) &&
        itemOk(items, 7) &&
        itemOk(items, 8) &&
        itemOk(items, 9) &&
        itemOk(items, 10) &&
        itemOk(items, 11) &&
        itemOk(items, 12) &&
        itemOk(items, 13) &&
        itemOk(items, 14) &&
        itemOk(items, 15) &&
        itemOk(items, 16) &&
        itemOk(items, 17) &&
        itemOk(items, 18) &&
        itemOk(items, 19) &&
        itemOk(items, 20) &&
        itemOk(items, 21) &&
        itemOk(items, 22) &&
        itemOk(items, 23) &&
        itemOk(items, 24) &&
        itemOk(items, 25) &&
        itemOk(items, 26) &&
        itemOk(items, 27) &&
        itemOk(items, 28) &&
        itemOk(items, 29);
    }

    // Product catalog — public storefront read, admin-only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin()
        // Basic shape guard so a compromised/careless admin session can't
        // write a type that breaks the site (e.g. price as a string).
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — never created or deleted from the client. Creation happens
    // server-side via the Admin SDK (app/api/orders, which bypasses these
    // rules entirely) so a customer's checkout never needs a client write
    // path opened here at all. A customer reads their own order only
    // through a server route that checks order ID + phone last 4
    // (app/api/orders/[orderId]) — also via the Admin SDK, not this rule.
    // This rule exists solely for the admin dashboard: read the queue,
    // and update status/confirmedTotal/etc.
    match /orders/{orderId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Shop settings (hours, WhatsApp number, DuitNow QR path) — public
    // read so every page can show current hours, admin-only write via
    // /admin/settings.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order ID counter — transactions only, via the Admin SDK
    // (app/api/orders), never touched by any client.
    match /counters/{id} {
      allow read, write: if false;
    }

    // Customer carts — saved so a signed-in customer's cart follows them
    // across devices. Doc ID = Firebase Auth UID. Unlike everything else
    // in this file, this collection IS directly client-writable: it's
    // owned entirely by the signed-in user themselves, same as any
    // per-user data (not shared, not trusted as input to anything else —
    // orders are still created and priced server-side regardless of what
    // a cart doc says).
    match /carts/{uid} {
      // Split, not a combined "allow read, write" — request.resource (the
      // write payload) only exists on write operations. Referencing it in
      // a rule that also covers read makes Firestore fail-closed on every
      // read, including the document's own owner, since the condition
      // errors out instead of evaluating true. (Found live: GET on a
      // user's own cart returned PERMISSION_DENIED despite uid matching.)
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.items is list
        // 30, not CartContext's own 50 cap: itemsValid() above only checks
        // indices 0-29 (Rules has no loop/forEach for a variable-length
        // list), so the cap here has to match what's actually validated.
        && request.resource.data.items.size() <= 30
        && itemsValid(request.resource.data.items);
    }

    // Admin allowlist. Doc ID = Firebase Auth UID. No client-writable path
    // at all — add/remove admins via the Firebase Console (Firestore Data
    // tab) or a trusted backend script, never from the app.
    //
    // allow get (not allow read): a signed-in user may fetch their OWN
    // admins/{uid} doc directly — lets AdminGuard ask "am I admin?" with
    // one unambiguous read instead of inferring it from whether an
    // unrelated orders probe happened to succeed (which also fails for
    // offline/network/quota reasons, misreporting a real admin as
    // "not authorized"). `list` stays unreachable (get != list in Firestore
    // Rules), so nobody can enumerate the allowlist even as a valid admin.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Analytics collections. The browser never writes to these directly —
    // app/api/analytics/route.ts validates and rate-limits events, then
    // writes via the Admin SDK, which authenticates as a trusted service
    // and bypasses these rules entirely. That's intentional: it's what
    // lets analytics work without ever opening public write access here.
    // Keep these closed to every client, always.
    match /searchLogs/{docId} {
      allow read, write: if false;
    }
    match /categoryLogs/{docId} {
      allow read, write: if false;
    }
    match /orderIntents/{docId} {
      allow read, write: if false;
    }
    match /productViews/{docId} {
      allow read, write: if false;
    }

    // Deny-by-default for anything not explicitly matched above,
    // including collections that don't exist yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
